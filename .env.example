# ---- LLM (Ollama) -----------------------------------------------------------
# Local Ollama (default). Cloud models run through your local Ollama daemon
# when you `ollama pull <model>-cloud`, or hit ollama.com directly with a key.
OLLAMA_HOST=http://localhost:11434
# Only needed when OLLAMA_HOST=https://ollama.com (direct cloud access):
OLLAMA_API_KEY=

# Comma-separated fallback chain, strongest first. Cloud-class models give the
# best analysis quality; keep at least one small local model as a last resort.
OLLAMA_MODELS=deepseek-v3.1:671b-cloud,gpt-oss:120b-cloud,qwen3:32b,llama3.1:8b

# ---- Data sources (all free) --------------------------------------------------
# SEC requires a descriptive User-Agent with contact email. Use YOUR email.
EDGAR_USER_AGENT=DeepValueFund research bot you@example.com
# Optional but recommended: free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ---- Fund ---------------------------------------------------------------------
FUND_CAPITAL_USD=1500000
FUND_TIMEZONE=America/New_York
